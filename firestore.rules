rules_version = '2';

// Deny everything by default. Each phase opens only what it needs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.trim().size() >= 2 && name.size() <= 60;
    }

    // Private profile: only its owner reads or writes it. Project members see each other's names
    // through projects/{id}.members instead (a copy kept by the project owner).
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Only the name can change.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);

      allow delete: if false;
    }

    // Email -> { uid, displayName } lookup for "add member by email".
    // get only (no list), so nobody can dump every registered email. It exposes just a name
    // to someone who already knows the email.
    match /userEmails/{email} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.keys().hasAll(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.displayName);

      // Only the account's own owner, and only the name (also fills it in for older accounts).
      allow update: if signedIn()
        && email == request.auth.token.email
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);

      allow delete: if false;
    }

    function validProjectFields(data) {
      return data.name is string
        && data.name.trim().size() >= 3 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 1000;
    }

    match /projects/{projectId} {
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }
      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      // A missing project can be "read" (it returns nothing), so the app can tell 404 from 403.
      allow get: if signedIn() && (resource == null || isMember());
      // Queries must be limited to the user's own projects (where memberIds array-contains uid).
      allow list: if signedIn() && isMember();

      // `members` mirrors `memberIds` with a display name per member.
      function validMemberEntry(entry) {
        return entry is map && entry.keys().hasOnly(['displayName']) && validName(entry.displayName);
      }

      // The owner changes membership one person at a time. Allowed shapes:
      //  - add one existing user (appended to memberIds, with a name entry),
      //  - remove one non-owner member,
      //  - first-time `members` for a project made before that field existed (owner only).
      function validMembership() {
        let before = resource.data;
        let after = request.resource.data;
        let ids = after.memberIds;
        let n = before.memberIds.size();
        return ids is list
          && after.members is map
          && ids.toSet().size() == ids.size()
          && ids.hasAll([before.ownerId])
          && ids.size() <= 20
          && after.members.keys().toSet() == ids.toSet()
          && (
            (!('members' in before) && ids == [before.ownerId] && validMemberEntry(after.members[before.ownerId]))
            || (ids.size() == n + 1
                && ids[0:n] == before.memberIds
                && exists(/databases/$(database)/documents/users/$(ids[n]))
                && validMemberEntry(after.members[ids[n]])
                && after.members.diff(before.members).affectedKeys().hasOnly([ids[n]]))
            || (ids.size() == n - 1
                && ids.hasOnly(before.memberIds)
                && after.members.diff(before.members).affectedKeys().size() == 1)
          );
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'members', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'members', 'createdAt', 'updatedAt'])
        && validProjectFields(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members is map
        && request.resource.data.members.keys() == [request.auth.uid]
        && validMemberEntry(request.resource.data.members[request.auth.uid])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Owner only: details and membership. ownerId / createdAt never change.
      allow update: if signedIn() && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'memberIds', 'members', 'updatedAt'])
        && validProjectFields(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members']) || validMembership());

      allow delete: if signedIn() && isOwner();

      // Tasks. Keep in sync with src/lib/permissions.js.
      match /tasks/{taskId} {
        function project() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }
        function inProject() {
          return signedIn() && request.auth.uid in project().memberIds;
        }
        function ownsProject() {
          return signedIn() && request.auth.uid == project().ownerId;
        }
        function validTask(data) {
          return data.title is string
            && data.title.trim().size() >= 3 && data.title.size() <= 120
            && data.description is string && data.description.size() <= 1000
            && data.status in ['todo', 'in_progress', 'done']
            && data.priority in ['low', 'medium', 'high']
            && (data.assigneeId == null || data.assigneeId in project().memberIds)
            && (data.dueDate == null || (data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        }
        function taskKeys() {
          return ['title', 'description', 'status', 'priority', 'assigneeId', 'dueDate', 'createdBy', 'createdAt', 'updatedAt'];
        }

        allow read: if inProject();

        // Any member; always starts as "todo" and is credited to its creator.
        allow create: if inProject()
          && request.resource.data.keys().hasOnly(taskKeys())
          && request.resource.data.keys().hasAll(taskKeys())
          && validTask(request.resource.data)
          && request.resource.data.status == 'todo'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Owner, creator or assignee. Status: owner or current assignee only.
        // createdBy / createdAt never change.
        allow update: if inProject()
          && (ownsProject() || resource.data.createdBy == request.auth.uid || resource.data.assigneeId == request.auth.uid)
          && request.resource.data.keys().hasOnly(taskKeys())
          && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || ownsProject() || resource.data.assigneeId == request.auth.uid);

        // Owner or creator.
        allow delete: if ownsProject() || (inProject() && resource.data.createdBy == request.auth.uid);
      }
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
